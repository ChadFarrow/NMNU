# Lightning Network Development Environment
# Copy this file to .env.local for Lightning-enabled development
# 
# Usage: cp env.lightning.template .env.local

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Site Branding (optional - defaults to "Music Site")
NEXT_PUBLIC_SITE_NAME=Music Site

# Environment
NODE_ENV=development

# Lightning Network Features (enabled)
NEXT_PUBLIC_ENABLE_LIGHTNING=true

# Optional: Custom Domain for Images
# NEXT_PUBLIC_IMAGE_DOMAIN=localhost:3000

# Nostr Configuration (optional)
# NOSTR_RELAY_URLS=wss://relay.damus.io,wss://relay.snort.social
# NOSTR_PRIVATE_KEY=your-nostr-private-key

# Site Nostr Account (optional - for permanent site identity)
# Generate a pair with `node scripts/generate-nostr-keys.js`, or use one from nostrudel.ninja.
# The nsec is server-only: /api/nostr/publish signs boost notes with it. Never give it
# a NEXT_PUBLIC_ prefix — Next inlines every NEXT_PUBLIC_ value into the browser bundle.
# SITE_NOSTR_NSEC=nsec1...
# NEXT_PUBLIC_SITE_NOSTR_NPUB=npub1...

# Helipad Integration (optional - for testing)
# HELIPAD_WEBHOOK_SECRET=your-webhook-secret
# HELIPAD_AUTH_TOKEN=your-auth-token
